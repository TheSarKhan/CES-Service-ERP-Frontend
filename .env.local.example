# Public base URL of the CES Service Spring Boot backend (without /api/v1 suffix).
NEXT_PUBLIC_API_URL=http://localhost:8080

# next-auth / session configuration (reserved for the BFF auth layer).
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-in-production

# Public base URL printed onto QR labels (falls back to the current origin when unset).
NEXT_PUBLIC_APP_URL=http://localhost:3000
